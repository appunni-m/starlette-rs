{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://starlette-rs.dev/schemas/migration-parity-upstream-benchmark-result-v1.json",
  "title": "Pinned Starlette upstream benchmark result",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "completion_scope",
    "identity",
    "status",
    "summary",
    "workloads"
  ],
  "properties": {
    "schema": {
      "const": "migration-parity/upstream-benchmark-result@1"
    },
    "completion_scope": {
      "const": "pinned source versus installed Python package"
    },
    "identity": {
      "$ref": "#/$defs/identity"
    },
    "status": {
      "enum": [
        "completed",
        "not_proven"
      ]
    },
    "summary": {
      "$ref": "#/$defs/summary"
    },
    "workloads": {
      "type": "array",
      "minItems": 74,
      "maxItems": 74,
      "items": {
        "$ref": "#/$defs/workload"
      }
    }
  },
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "nonEmptyString": {
      "type": "string",
      "minLength": 1
    },
    "nonNegativeInteger": {
      "type": "integer",
      "minimum": 0
    },
    "positiveNumber": {
      "type": "number",
      "exclusiveMinimum": 0
    },
    "fileIdentity": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "sha256"
      ],
      "properties": {
        "path": {
          "type": "string",
          "minLength": 1
        },
        "sha256": {
          "$ref": "#/$defs/sha256"
        }
      }
    },
    "inputIdentity": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "schema",
        "sha256"
      ],
      "properties": {
        "path": {
          "const": "build/parity/inputs/benchmark/starlette-upstream-workloads.json"
        },
        "schema": {
          "const": "migration-parity/upstream-benchmark-input@1"
        },
        "sha256": {
          "$ref": "#/$defs/sha256"
        }
      }
    },
    "manifestIdentity": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "schema",
        "sha256"
      ],
      "properties": {
        "path": {
          "const": "tests/fixtures/manifest.yaml"
        },
        "schema": {
          "const": "migration-parity/manifest@2"
        },
        "sha256": {
          "$ref": "#/$defs/sha256"
        }
      }
    },
    "parityGateSummary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "selected",
        "executed",
        "passed",
        "failed",
        "not_run",
        "infrastructure_errors"
      ],
      "properties": {
        "selected": {
          "$ref": "#/$defs/nonNegativeInteger"
        },
        "executed": {
          "$ref": "#/$defs/nonNegativeInteger"
        },
        "passed": {
          "$ref": "#/$defs/nonNegativeInteger"
        },
        "failed": {
          "$ref": "#/$defs/nonNegativeInteger"
        },
        "not_run": {
          "$ref": "#/$defs/nonNegativeInteger"
        },
        "infrastructure_errors": {
          "$ref": "#/$defs/nonNegativeInteger"
        }
      }
    },
    "parityGateIdentity": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "run_id",
        "sha256",
        "summary"
      ],
      "properties": {
        "path": {
          "const": "build/parity/upstream-benchmark-correctness-result.json"
        },
        "run_id": {
          "type": [
            "string",
            "null"
          ],
          "minLength": 1
        },
        "sha256": {
          "$ref": "#/$defs/sha256"
        },
        "summary": {
          "$ref": "#/$defs/parityGateSummary"
        }
      }
    },
    "environmentIdentity": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "python",
        "runtime",
        "os",
        "architecture",
        "dependency_lock_path",
        "dependency_lock_sha256",
        "installed_lock_sha256",
        "artifact_sha256",
        "environment_sha256"
      ],
      "properties": {
        "id": {
          "enum": [
            "starlette-oracle-cpython312",
            "starlette-rs-py-cpython312"
          ]
        },
        "python": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "runtime": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "os": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "architecture": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "dependency_lock_path": {
          "const": "scripts/parity/locks/asgi-runtime-cpython312.txt"
        },
        "dependency_lock_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "installed_lock_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "artifact_sha256": {
          "anyOf": [
            {
              "$ref": "#/$defs/sha256"
            },
            {
              "type": "null"
            }
          ]
        },
        "environment_sha256": {
          "$ref": "#/$defs/sha256"
        }
      }
    },
    "machineIdentity": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "platform",
        "architecture",
        "processor",
        "logical_cpu_count",
        "python",
        "python_executable"
      ],
      "properties": {
        "platform": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "architecture": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "processor": {
          "type": "string"
        },
        "logical_cpu_count": {
          "anyOf": [
            {
              "$ref": "#/$defs/nonNegativeInteger"
            },
            {
              "type": "null"
            }
          ]
        },
        "python": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "python_executable": {
          "$ref": "#/$defs/nonEmptyString"
        }
      }
    },
    "commandIdentity": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "argv",
        "cwd"
      ],
      "properties": {
        "argv": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/nonEmptyString"
          }
        },
        "cwd": {
          "$ref": "#/$defs/nonEmptyString"
        }
      }
    },
    "identity": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "run_id",
        "started_at",
        "finished_at",
        "input",
        "manifest",
        "source_revision",
        "source_files",
        "parity_gate",
        "prepared_environments",
        "machine",
        "command"
      ],
      "properties": {
        "run_id": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "started_at": {
          "type": "string",
          "format": "date-time"
        },
        "finished_at": {
          "type": "string",
          "format": "date-time"
        },
        "input": {
          "$ref": "#/$defs/inputIdentity"
        },
        "manifest": {
          "$ref": "#/$defs/manifestIdentity"
        },
        "source_revision": {
          "const": "4f250d6b814587e20c5365f0a5f0c4d42bcb929f"
        },
        "source_files": {
          "type": "array",
          "minItems": 2,
          "maxItems": 2,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/fileIdentity"
          }
        },
        "parity_gate": {
          "$ref": "#/$defs/parityGateIdentity"
        },
        "prepared_environments": {
          "type": "array",
          "minItems": 2,
          "maxItems": 2,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/environmentIdentity"
          }
        },
        "machine": {
          "$ref": "#/$defs/machineIdentity"
        },
        "command": {
          "$ref": "#/$defs/commandIdentity"
        }
      }
    },
    "summary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "declared",
        "measured",
        "not_run",
        "failed",
        "native_not_run_workloads",
        "router_measured",
        "gzip_measured"
      ],
      "properties": {
        "declared": {
          "const": 74
        },
        "measured": {
          "type": "integer",
          "minimum": 0,
          "maximum": 74
        },
        "not_run": {
          "type": "integer",
          "minimum": 0,
          "maximum": 74
        },
        "failed": {
          "type": "integer",
          "minimum": 0,
          "maximum": 74
        },
        "native_not_run_workloads": {
          "const": 74
        },
        "router_measured": {
          "type": "integer",
          "minimum": 0,
          "maximum": 6
        },
        "gzip_measured": {
          "type": "integer",
          "minimum": 0,
          "maximum": 68
        }
      }
    },
    "relation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "relation",
        "status"
      ],
      "properties": {
        "relation": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "status": {
          "const": "pass"
        }
      }
    },
    "runnerPolicy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "warmup_iterations",
        "samples",
        "iterations_per_sample",
        "sample_statistic"
      ],
      "properties": {
        "warmup_iterations": {
          "$ref": "#/$defs/nonNegativeInteger"
        },
        "samples": {
          "type": "integer",
          "minimum": 1
        },
        "iterations_per_sample": {
          "type": "integer",
          "minimum": 1
        },
        "sample_statistic": {
          "const": "mean_call_duration"
        }
      }
    },
    "measurementPolicy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "setup_outside_timer",
        "timed_call",
        "post_timer_checks",
        "source_harness",
        "runner_policy"
      ],
      "properties": {
        "setup_outside_timer": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/nonEmptyString"
          }
        },
        "timed_call": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "boundary_id",
            "includes"
          ],
          "properties": {
            "boundary_id": {
              "$ref": "#/$defs/nonEmptyString"
            },
            "includes": {
              "type": "array",
              "minItems": 1,
              "items": {
                "$ref": "#/$defs/nonEmptyString"
              }
            }
          }
        },
        "post_timer_checks": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/nonEmptyString"
          }
        },
        "source_harness": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "package",
            "method",
            "marker",
            "rounds"
          ],
          "properties": {
            "package": {
              "$ref": "#/$defs/nonEmptyString"
            },
            "method": {
              "$ref": "#/$defs/nonEmptyString"
            },
            "marker": {
              "anyOf": [
                {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "max_time_seconds",
                    "max_rounds"
                  ],
                  "properties": {
                    "max_time_seconds": {
                      "$ref": "#/$defs/positiveNumber"
                    },
                    "max_rounds": {
                      "type": "integer",
                      "minimum": 1
                    }
                  }
                },
                {
                  "type": "null"
                }
              ]
            },
            "rounds": {
              "anyOf": [
                {
                  "type": "integer",
                  "minimum": 1
                },
                {
                  "type": "null"
                }
              ]
            }
          }
        },
        "runner_policy": {
          "$ref": "#/$defs/runnerPolicy"
        }
      }
    },
    "measurement": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "unit",
        "runner_policy",
        "warmup_iterations",
        "samples",
        "iterations_per_sample",
        "statistics"
      ],
      "properties": {
        "unit": {
          "const": "nanoseconds_per_operation"
        },
        "runner_policy": {
          "$ref": "#/$defs/runnerPolicy"
        },
        "warmup_iterations": {
          "$ref": "#/$defs/nonNegativeInteger"
        },
        "samples": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/positiveNumber"
          }
        },
        "iterations_per_sample": {
          "type": "integer",
          "minimum": 1
        },
        "statistics": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "median",
            "mean",
            "stdev",
            "min",
            "max",
            "p50",
            "p95",
            "p99"
          ],
          "properties": {
            "median": {
              "$ref": "#/$defs/positiveNumber"
            },
            "mean": {
              "$ref": "#/$defs/positiveNumber"
            },
            "stdev": {
              "type": "number",
              "minimum": 0
            },
            "min": {
              "$ref": "#/$defs/positiveNumber"
            },
            "max": {
              "$ref": "#/$defs/positiveNumber"
            },
            "p50": {
              "$ref": "#/$defs/positiveNumber"
            },
            "p95": {
              "$ref": "#/$defs/positiveNumber"
            },
            "p99": {
              "$ref": "#/$defs/positiveNumber"
            }
          }
        }
      }
    },
    "capabilities": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "router_instance_is_asgi_callable",
        "gzip_middleware_available"
      ],
      "properties": {
        "router_instance_is_asgi_callable": {
          "type": "boolean"
        },
        "gzip_middleware_available": {
          "type": "boolean"
        }
      }
    },
    "sourceWorkerIdentity": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "subject_id",
        "starlette_version",
        "source_revision",
        "module_path",
        "python_executable",
        "environment_prefix",
        "runtime",
        "os",
        "architecture",
        "capabilities"
      ],
      "properties": {
        "subject_id": {
          "const": "starlette-python"
        },
        "starlette_version": {
          "const": "1.6.0"
        },
        "source_revision": {
          "const": "4f250d6b814587e20c5365f0a5f0c4d42bcb929f"
        },
        "module_path": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "python_executable": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "environment_prefix": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "runtime": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "os": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "architecture": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "capabilities": {
          "$ref": "#/$defs/capabilities"
        }
      }
    },
    "packageWorkerIdentity": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "subject_id",
        "starlette_version",
        "package_version",
        "module_path",
        "core_extension_path",
        "python_executable",
        "environment_prefix",
        "runtime",
        "os",
        "architecture",
        "target_tree_sha256",
        "wheel_sha256",
        "capabilities"
      ],
      "properties": {
        "subject_id": {
          "const": "python-package-cpython312"
        },
        "starlette_version": {
          "const": "0.1.0"
        },
        "package_version": {
          "const": "0.1.0"
        },
        "module_path": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "core_extension_path": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "python_executable": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "environment_prefix": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "runtime": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "os": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "architecture": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "target_tree_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "wheel_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "capabilities": {
          "$ref": "#/$defs/capabilities"
        }
      }
    },
    "workerIdentity": {
      "oneOf": [
        {
          "$ref": "#/$defs/sourceWorkerIdentity"
        },
        {
          "$ref": "#/$defs/packageWorkerIdentity"
        }
      ]
    },
    "targetIdentity": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "target_profile",
        "target_id",
        "revision",
        "dirty",
        "runtime",
        "backend",
        "features",
        "package_version",
        "target_tree_sha256",
        "dependency_lock_sha256",
        "os",
        "architecture",
        "environment_sha256"
      ],
      "properties": {
        "target_profile": {
          "enum": [
            "rust-native-local",
            "python-package-cpython312"
          ]
        },
        "target_id": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "revision": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "dirty": {
          "type": "boolean"
        },
        "runtime": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "backend": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "features": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "package_version": {
          "type": [
            "string",
            "null"
          ]
        },
        "target_tree_sha256": {
          "anyOf": [
            {
              "$ref": "#/$defs/sha256"
            },
            {
              "type": "null"
            }
          ]
        },
        "dependency_lock_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "os": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "architecture": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "environment_sha256": {
          "anyOf": [
            {
              "$ref": "#/$defs/sha256"
            },
            {
              "type": "null"
            }
          ]
        }
      }
    },
    "sourcePackageSubject": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "subject_id",
            "status",
            "identity",
            "reason"
          ],
          "properties": {
            "subject_id": {
              "enum": [
                "starlette-python",
                "python-package-cpython312"
              ]
            },
            "status": {
              "const": "not_run"
            },
            "identity": {
              "type": "null"
            },
            "reason": {
              "$ref": "#/$defs/nonEmptyString"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "subject_id",
            "status",
            "identity",
            "input_relations"
          ],
          "properties": {
            "subject_id": {
              "enum": [
                "starlette-python",
                "python-package-cpython312"
              ]
            },
            "status": {
              "const": "probed"
            },
            "identity": {
              "$ref": "#/$defs/workerIdentity"
            },
            "input_relations": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/relation"
              }
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "subject_id",
            "status",
            "identity",
            "input_relations",
            "measurement"
          ],
          "properties": {
            "subject_id": {
              "enum": [
                "starlette-python",
                "python-package-cpython312"
              ]
            },
            "status": {
              "const": "measured"
            },
            "identity": {
              "$ref": "#/$defs/workerIdentity"
            },
            "input_relations": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/relation"
              }
            },
            "measurement": {
              "$ref": "#/$defs/measurement"
            }
          }
        }
      ]
    },
    "nativeSubject": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "subject_id",
        "status",
        "identity",
        "reason"
      ],
      "properties": {
        "subject_id": {
          "const": "rust-native-local"
        },
        "status": {
          "const": "not_run"
        },
        "identity": {
          "anyOf": [
            {
              "$ref": "#/$defs/targetIdentity"
            },
            {
              "type": "null"
            }
          ]
        },
        "reason": {
          "$ref": "#/$defs/nonEmptyString"
        }
      }
    },
    "subjects": {
      "type": "array",
      "minItems": 3,
      "maxItems": 3,
      "prefixItems": [
        {
          "$ref": "#/$defs/sourcePackageSubject"
        },
        {
          "$ref": "#/$defs/sourcePackageSubject"
        },
        {
          "$ref": "#/$defs/nativeSubject"
        }
      ],
      "items": false
    },
    "measuredGate": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "source_observation_sha256",
        "target_observation_sha256",
        "normalized_source_observation_sha256",
        "normalized_target_observation_sha256",
        "normalization"
      ],
      "properties": {
        "status": {
          "const": "pass"
        },
        "source_observation_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "target_observation_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "normalized_source_observation_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "normalized_target_observation_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "normalization": {
          "$ref": "#/$defs/nonEmptyString"
        }
      }
    },
    "notRunGate": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status"
      ],
      "properties": {
        "status": {
          "const": "not_run"
        }
      }
    },
    "failedGate": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
