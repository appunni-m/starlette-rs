{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://starlette-rs.dev/schemas/migration-parity-coverage-receipt-v1.json",
  "title": "Strict receipt binding a managed coverage result to its build and source evidence",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "profile_id",
    "target",
    "source",
    "manifest",
    "inputs",
    "assets",
    "dependency_locks",
    "target_artifact",
    "collector",
    "raw_profiles",
    "outputs",
    "selected_outcomes"
  ],
  "properties": {
    "schema": {
      "const": "migration-parity/coverage-receipt@1"
    },
    "profile_id": {
      "type": "string",
      "minLength": 1
    },
    "target": {
      "$ref": "#/$defs/target"
    },
    "source": {
      "$ref": "#/$defs/source"
    },
    "manifest": {
      "$ref": "#/$defs/manifest"
    },
    "inputs": {
      "type": "array",
      "minItems": 2,
      "items": {
        "$ref": "#/$defs/input"
      }
    },
    "assets": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/asset"
      }
    },
    "dependency_locks": {
      "type": "array",
      "minItems": 3,
      "maxItems": 3,
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/dependencyLock"
      }
    },
    "target_artifact": {
      "$ref": "#/$defs/targetArtifact"
    },
    "collector": {
      "$ref": "#/$defs/collector"
    },
    "raw_profiles": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/rawProfile"
      }
    },
    "outputs": {
      "$ref": "#/$defs/outputs"
    },
    "selected_outcomes": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/selectedOutcome"
      }
    }
  },
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "repositoryPath": {
      "type": "string",
      "minLength": 1,
      "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))(?!.*\\\\)[A-Za-z0-9._/-]+$"
    },
    "runPath": {
      "type": "string",
      "minLength": 1,
      "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))(?!.*\\\\)[A-Za-z0-9._/-]+$"
    },
    "target": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "revision",
        "dirty"
      ],
      "properties": {
        "revision": {
          "type": "string",
          "pattern": "^(?:[a-f0-9]{40}|[a-f0-9]{64})$"
        },
        "dirty": {
          "const": false
        }
      }
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "tree_sha256"
      ],
      "properties": {
        "tree_sha256": {
          "$ref": "#/$defs/sha256"
        }
      }
    },
    "manifest": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "schema",
        "sha256"
      ],
      "properties": {
        "path": {
          "$ref": "#/$defs/repositoryPath"
        },
        "schema": {
          "const": "migration-parity/manifest@6"
        },
        "sha256": {
          "$ref": "#/$defs/sha256"
        }
      }
    },
    "input": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "schema",
        "sha256"
      ],
      "properties": {
        "path": {
          "$ref": "#/$defs/repositoryPath"
        },
        "schema": {
          "enum": [
            "migration-parity/coverage-input@1",
            "migration-parity/parity-input@60",
            "migration-parity/parity-input@61",
            "migration-parity/parity-input@62",
            "migration-parity/parity-input@63",
            "migration-parity/parity-input@64",
            "migration-parity/parity-input@65",
            "migration-parity/parity-input@66",
            "migration-parity/parity-input@67",
            "migration-parity/parity-input@69"
          ]
        },
        "sha256": {
          "$ref": "#/$defs/sha256"
        }
      }
    },
    "asset": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "input_path",
        "item_id",
        "asset_id",
        "kind",
        "locator",
        "sha256"
      ],
      "properties": {
        "input_path": {
          "$ref": "#/$defs/repositoryPath"
        },
        "item_id": {
          "type": "string",
          "minLength": 1
        },
        "asset_id": {
          "type": "string",
          "minLength": 1
        },
        "kind": {
          "const": "inline"
        },
        "locator": {
          "type": "string",
          "minLength": 1
        },
        "sha256": {
          "$ref": "#/$defs/sha256"
        }
      }
    },
    "dependencyLock": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "purpose",
        "path",
        "sha256"
      ],
      "properties": {
        "purpose": {
          "enum": [
            "build",
            "oracle",
            "target"
          ]
        },
        "path": {
          "$ref": "#/$defs/repositoryPath"
        },
        "sha256": {
          "$ref": "#/$defs/sha256"
        }
      }
    },
    "targetArtifact": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "path",
        "sha256"
      ],
      "properties": {
        "kind": {
          "enum": [
            "rust-native-executable",
            "python-extension-module"
          ]
        },
        "path": {
          "$ref": "#/$defs/runPath"
        },
        "sha256": {
          "$ref": "#/$defs/sha256"
        }
      }
    },
    "fileReceipt": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "sha256"
      ],
      "properties": {
        "path": {
          "$ref": "#/$defs/runPath"
        },
        "sha256": {
          "$ref": "#/$defs/sha256"
        }
      }
    },
    "collector": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "version",
        "configuration",
        "logs",
        "toolchain"
      ],
      "properties": {
        "name": {
          "const": "cargo-llvm-cov"
        },
        "version": {
          "const": "0.8.7"
        },
        "configuration": {
          "$ref": "#/$defs/fileReceipt"
        },
        "logs": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "build",
            "report",
            "show_env"
          ],
          "properties": {
            "build": {
              "$ref": "#/$defs/fileReceipt"
            },
            "report": {
              "$ref": "#/$defs/fileReceipt"
            },
            "show_env": {
              "$ref": "#/$defs/fileReceipt"
            }
          }
        },
        "toolchain": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "path",
            "sha256",
            "cargo",
            "cargo_llvm_cov",
            "rustc",
            "llvm_cov",
            "llvm_profdata"
          ],
          "properties": {
            "path": {
              "$ref": "#/$defs/runPath"
            },
            "sha256": {
              "$ref": "#/$defs/sha256"
            },
            "cargo": {
              "type": "string",
              "minLength": 1
            },
            "cargo_llvm_cov": {
              "type": "string",
              "minLength": 1
            },
            "rustc": {
              "type": "string",
              "minLength": 1
            },
            "llvm_cov": {
              "type": "string",
              "minLength": 1
            },
            "llvm_profdata": {
              "type": "string",
              "minLength": 1
            }
          }
        }
      }
    },
    "rawProfile": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "sha256",
        "size_bytes"
      ],
      "properties": {
        "path": {
          "$ref": "#/$defs/runPath"
        },
        "sha256": {
          "$ref": "#/$defs/sha256"
        },
        "size_bytes": {
          "type": "integer",
          "minimum": 1
        }
      }
    },
    "outputs": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "lcov",
        "coverage_result"
      ],
      "properties": {
        "lcov": {
          "$ref": "#/$defs/fileReceipt"
        },
        "coverage_result": {
          "$ref": "#/$defs/fileReceipt"
        }
      }
    },
    "selectedOutcome": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "case_id",
        "outcome"
      ],
      "properties": {
        "case_id": {
          "type": "string",
          "minLength": 1
        },
        "outcome": {
          "const": "pass"
        }
      }
    }
  }
}
